# Copy to .env for local dev. NEVER commit a filled .env to git.
# Production values live in the Render dashboard (see render.yaml).

# Bearer token remote MCP clients must send:  Authorization: Bearer <token>
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_ACCESS_TOKEN=

# Separate secret for admin dashboard login + /admin/* API.
# Must differ from MCP_ACCESS_TOKEN.
ADMIN_TOKEN=

# Primary store: TiDB (MySQL), Postgres, or sqlite file (local dev only).
#   TiDB:            mysql://user:pass@gateway01....tidbcloud.com:4000/dbname
#   Postgres:        postgresql://user:pass@host:5432/db
#   Local dev:       sqlite:///./data/kxstrel.db
DATABASE_URL=sqlite:///./data/kxstrel.db

# Optional backup store (Postgres-compatible, e.g. CockroachDB):
# Every run appends a new snapshot (accounts + schema_migrations + tool flags
# + admin audit); the previous ones are never overwritten.
# BACKUP_DATABASE_URL=postgresql://user:pass@host:26257/db?sslmode=verify-full
BACKUP_DATABASE_URL=

# Fernet key encrypting stored auth_token/ct0.
# Generate: python scripts/setup_account.py --generate-key
CREDENTIAL_ENCRYPTION_KEY=

# Database startup resilience. connect() + schema init run with bounded
# retry: attempt 1 is immediate, then the delay doubles per attempt
# (base * 2^(n-1)) and is capped, plus up to 100% jitter. A store that is
# still unreachable after the attempts starts the gateway in degraded mode
# (the existing fallback paths keep working) instead of hanging.
# Applies to the primary AND the backup store.
DB_CONNECT_MAX_ATTEMPTS=5
DB_CONNECT_BASE_DELAY_SECONDS=1.0
DB_CONNECT_MAX_DELAY_SECONDS=15.0

# Optional Redis (shared admin sessions across instances).
# REDIS_URL=rediss://user:pass@host:6379
REDIS_URL=

# Local cache of spectre's twscrape pool. Ephemeral-safe: rebuilt from the
# database on every startup, so /tmp or ./data are both fine.
SPECTRE_DB_PATH=./data/spectre-accounts.db

# Optional tuning.
PORT=8000
# Optional, NON-secret: the public origin this gateway advertises to clients
# in 401 challenges and protected-resource metadata, e.g.
#   PUBLIC_BASE_URL=https://x-mcp.onrender.com
# Scheme + host only (no path, no trailing slash). When set it is
# authoritative and client-supplied Host / X-Forwarded-Host headers are
# ignored; when unset the origin is derived from those headers, validated.
PUBLIC_BASE_URL=
LOG_LEVEL=INFO
SESSION_CHECK_INTERVAL_SECONDS=1800
SESSION_CHECK_TIMEOUT_SECONDS=45
VALIDATE_ON_STARTUP=true
RATE_LIMIT_MCP_PER_MIN=120
RATE_LIMIT_ADMIN_PER_MIN=20
# Identical tool calls (same caller, same tool) that run at once. The next
# identical call is refused with a retry-after hint, never queued; calls of
# other tools, and calls from other callers, are unaffected.
TOOL_MAX_CONCURRENT_IDENTICAL=2
# Spacing for overlapping identical follow-up calls: the seconds that follow-up
# waits is TOOL_MIN_GAP_SECONDS + uniform(0, TOOL_GAP_JITTER_SECONDS). The
# jitter is deliberate: a perfectly regular cadence is itself an automation
# signature. Set both to 0 to disable the wait (the concurrency cap stays).
TOOL_MIN_GAP_SECONDS=1.5
TOOL_GAP_JITTER_SECONDS=3.0
SESSION_TTL_HOURS=8
USAGE_LOG_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
# How long a backup snapshot is kept. Snapshots older than this are pruned
# after each successful run (minimum 1 day).
BACKUP_RETENTION_DAYS=10
ALLOWED_ORIGINS=*
DEBUG=false
